# =============================================
# Prepady — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# =============================================

# --- DATABASE (Postgres — Neon or Supabase) ---
# IMPORTANT: run `pnpm migrate` over a SESSION pooler / direct connection (port 5432),
# not the transaction pooler (6543) — migrations hang on the transaction pooler.
DATABASE_URI=postgresql://user:password@host:5432/prepady?sslmode=require

# --- PAYLOAD CMS ---
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- APP URL ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- CLAUDE (AI layer) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model per feature (cost lever — see README → unit economics). Defaults shown.
AI_EXPLAIN_MODEL=claude-haiku-4-5
AI_MARKING_MODEL=claude-sonnet-4-6

# --- PAYSTACK (payments — Phase 1) ---
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# --- RESEND (transactional email: password reset, etc.) ---
# Reuses Myedupady's Resend account. RESEND_FROM_EMAIL must be a verified sender
# (e.g. no-reply@myedupady.com until Prepady has its own verified domain).
# Leave RESEND_API_KEY blank to skip email (auth still works; reset emails are no-ops).
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@myedupady.com

# --- CLOUDINARY (media storage) ---
# Reuses the same Cloudinary account as Myedupady; Prepady uploads go to the
# "prepady/" folder. Leave blank to use local-disk storage in dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- GOOGLE SIGN-IN (optional) ---
# Set the OAuth client ID to show the "Continue with Google" button on
# /login and /signup. Leave blank to use email + password only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
