# =============================================
# Prepady — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# =============================================

# --- DATABASE (Postgres — Neon or Supabase) ---
# IMPORTANT: run `pnpm migrate` over a SESSION pooler / direct connection (port 5432),
# not the transaction pooler (6543) — migrations hang on the transaction pooler.
DATABASE_URI=postgresql://user:password@host:5432/prepady?sslmode=require

# --- PAYLOAD CMS ---
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- APP URL ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- AI LAYER (see docs/AI-ARCHITECTURE.md) ---
# Active provider: 'anthropic' (default) or 'gemini' (stub — see the doc to finish it).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional free-tier provider; leave blank until the Gemini provider is implemented.
GOOGLE_API_KEY=
# Model per feature (cost lever — see docs/AI-ARCHITECTURE.md). Defaults shown.
AI_EXPLAIN_MODEL=claude-haiku-4-5
AI_FOLLOWUP_MODEL=claude-haiku-4-5
# Marking: claude-sonnet-5-5 ($2/$10) is cheaper + better than 4-5 ($3/$15). Use claude-sonnet-4-5 if 5-5 isn't on your org.
AI_MARKING_MODEL=claude-sonnet-5-5
# Operational defaults (admins can override these live in /admin → AI Controls & Usage).
AI_AUTOGEN_ON_PUBLISH=true     # auto-generate an explanation when an MCQ is published without one
AI_MONTHLY_BUDGET_USD=25       # live AI blocked once this month's measured spend is reached (0 = no cap)
AI_PAUSED=false                # emergency kill switch for all live AI calls
AI_REQUIRE_VERIFIED_EMAIL=false # when true, live AI requires a confirmed email (stored explanations stay free)

# --- BOT / ABUSE PROTECTION (see docs/SECURITY.md) ---
# Distributed rate limiting (Vercel KV / Upstash Redis). Leave blank to use the
# in-memory fallback in dev; set in production so limits hold across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile CAPTCHA on signup + password reset. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- PAYSTACK (payments — Phase 1) ---
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# --- RESEND (transactional email: password reset, etc.) ---
# Reuses Myedupady's Resend account. RESEND_FROM_EMAIL must be a verified sender
# (e.g. no-reply@myedupady.com until Prepady has its own verified domain).
# Leave RESEND_API_KEY blank to skip email (auth still works; reset emails are no-ops).
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@myedupady.com

# --- CLOUDINARY (media storage) ---
# Reuses the same Cloudinary account as Myedupady; Prepady uploads go to the
# "prepady/" folder. Leave blank to use local-disk storage in dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- GOOGLE SIGN-IN (optional) ---
# Set the OAuth client ID to show the "Continue with Google" button on
# /login and /signup. Leave blank to use email + password only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
